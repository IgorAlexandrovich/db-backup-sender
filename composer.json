{
    "name": "ibaranov/db-backup-sender",
    "version": "1.0.0",
    "description": "Почасовое резервное копирование баз MySQL/MariaDB Laravel-проектов с отправкой дампа на удалённый приёмник",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "backup",
        "mysql",
        "mariadb",
        "mysqldump",
        "database"
    ],
    "authors": [
        {
            "name": "Your Vendor",
            "email": "dev@example.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-zlib": "*",
        "ext-hash": "*",
        "ext-json": "*",
        "illuminate/config": "^10.0|^11.0|^12.0",
        "illuminate/console": "^10.0|^11.0|^12.0",
        "illuminate/contracts": "^10.0|^11.0|^12.0",
        "illuminate/database": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0",
        "illuminate/log": "^10.0|^11.0|^12.0",
        "illuminate/mail": "^10.0|^11.0|^12.0",
        "illuminate/notifications": "^10.0|^11.0|^12.0",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "symfony/process": "^6.0|^7.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.5|^11.0"
    },
    "autoload": {
        "psr-4": {
            "YourVendor\\DbBackup\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "YourVendor\\DbBackup\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "YourVendor\\DbBackup\\BackupServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "phpunit",
        "test-unit": "phpunit --exclude-group integration"
    },
    "support": {
        "issues": "https://github.com/your-vendor/db-backup-sender/issues",
        "source": "https://github.com/your-vendor/db-backup-sender"
    }
}
